spring.application.name={{ artifact_id }}

spring.datasource.url=${DB_URL:{{ datasource_url }}}
spring.datasource.username=${DB_USERNAME:{{ datasource_username }}}
spring.datasource.password=${DB_PASSWORD:{{ datasource_password }}}
spring.datasource.driver-class-name={{ datasource_driver }}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect={{ hibernate_dialect }}
